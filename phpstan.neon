parameters:
  level: 6
  # Contao's model PHPDoc is not trustworthy enough to narrow on: findAll() is annotated
  # "Collection|null" but callers still guard against other shapes. With PHPDoc types treated as
  # certain, every such guard is reported as dead code.
  treatPhpDocTypesAsCertain: false
  paths:
    - src
    - contao
    - tests
  universalObjectCratesClasses:
    # Isotope 3 products are plain data objects with magic property access
    - Isotope\CoreBundle\Product\Product
    - Contao\Model
    - Contao\Template
  excludePaths:
    analyse:
      # Contao DCA files are arrays in a global, not analysable code
      - contao/dca/*
includes:
  - vendor/phpstan/phpstan-symfony/extension.neon
